{
  "name": "granttap-web",
  "version": "0.1.0",
  "private": true,
  "description": "Product website for GrantTap — Mesh, Governance, and coding-agent coordination across Mac, iPhone, iPad, and Apple Watch.",
  "homepage": "https://granttap.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/granttap-site.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/hetzner-connect.test.mjs tests/hetzner-passkey.test.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@levischuck/tiny-cbor": "^0.2.11",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.2.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.0",
    "vitest": "4.1.11",
    "wrangler": "4.118.0"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "5.2.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "undici": "7.29.0",
    "fast-uri": "3.1.7",
    "baseline-browser-mapping": "2.11.22",
    "fflate": "0.7.5",
    "browserslist": "4.28.9",
    "source-map-js": "1.2.2"
  }
}
