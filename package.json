{
  "name": "granttap-web",
  "version": "0.1.0",
  "private": true,
  "description": "Product website for GrantTap \u2014 iPhone and Apple Watch remote for Cursor, Claude Code, Codex, Copilot, and Grok Build.",
  "homepage": "https://granttap.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/granttap-site.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "5.2.3",
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "fast-uri": "3.1.5"
  }
}
